<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests automatisés d'Althéa (audit D-2) : xUnit v3, exécutés par Tools\test.cmd ou l'Explorateur de tests de VS.
       Même cible que l'application (WinForms) : le projet testé est référencé tel quel. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Althea.Tests</RootNamespace>
    <!-- Pas de « My.Application » : le point d'entrée est celui que génère xUnit. -->
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Althea.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="Xunit" />
  </ItemGroup>

</Project>
